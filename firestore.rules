rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRoomMember(roomId) {
      return signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
    }

    match /rooms/{roomId} {
      allow read: if signedIn() &&
          request.auth.uid in resource.data.memberIds;
      allow create, update, delete: if false;

      match /members/{userId} {
        allow read: if isRoomMember(roomId);
        allow create, update, delete: if false;

        match /stats/{summaryId} {
          allow read: if isRoomMember(roomId);
          allow write: if false;
        }

        match /monthlyStats/{monthId} {
          allow read: if isRoomMember(roomId);
          allow write: if false;
        }
      }

      match /stats/{summaryId} {
        allow read: if isRoomMember(roomId);
        allow write: if false;
      }

      match /monthlyStats/{monthId} {
        allow read: if isRoomMember(roomId);
        allow write: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isRoomMember(roomId);
        allow create, update, delete: if false;
      }
    }

    match /roomInvites/{inviteCode} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
